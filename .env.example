# Токен от @BotFather
BOT_TOKEN=

# Необязательно: путь к cookies.txt (формат Netscape), если YouTube или Instagram
# требуют входа. На Render это Secret File: /etc/secrets/cookies.txt
# COOKIES_FILE=cookies.txt

# Необязательно: публичный адрес для webhook. На Render задавать не нужно.
# WEBHOOK_URL=https://example.com

# Необязательно: платный прокси с «домашними» адресами — запасной путь, когда YouTube или
# Instagram не пускают сервер. Формат: http://логин:пароль@адрес:порт
# PROXY_URL=

# Необязательно: свой сервер cobalt для запасного скачивания (можно несколько через запятую).
# Без этого бот сам берёт открытые серверы с cobalt.directory.
# COBALT_API=cobalt.example.com

# Необязательно: свой сервер Invidious для YouTube (можно несколько через запятую).
# Без этого бот сам берёт серверы с открытым API с api.invidious.io.
# INVIDIOUS_API=invidious.example.com

# Необязательно: ключ RapidAPI для постов Instagram из профилей 18+ (без входа и cookies).
# Нужна подписка на бесплатный план Basic у API «Download All in One!» (coder2077).
# RAPIDAPI_KEY=
