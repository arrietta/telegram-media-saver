# Токен от @BotFather
BOT_TOKEN=

# Необязательно: путь к cookies.txt (формат Netscape), если YouTube или Instagram
# требуют входа. На Render это Secret File: /etc/secrets/cookies.txt
# COOKIES_FILE=cookies.txt

# Необязательно: публичный адрес для webhook. На Render задавать не нужно.
# WEBHOOK_URL=https://example.com

# Необязательно: ключ RapidAPI для сервиса «YouTube Media Downloader». Нужен, когда YouTube
# не отдаёт видео серверу («Sign in to confirm you're not a bot»).
# RAPIDAPI_KEY=
